rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isChatParticipant(chatId) {
      return isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // ----------------------------------------------------
    // Unique Username Index (Case-Insensitive Uniqueness)
    // ----------------------------------------------------
    match /usernames/{username} {
      allow read: if isAuthenticated();
      // Only authenticated user can claim an unoccupied username for themselves
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.username == username
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false; // Usernames cannot be transferred or edited directly
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    // ----------------------------------------------------
    // User Profiles, Followers & Friendships
    // ----------------------------------------------------
    match /users/{userId} {
      // Authenticated users can read public profile details
      allow read: if isAuthenticated();

      // Only the account owner can create and edit their profile (or follow count increments from authorized actions)
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isAuthenticated() && (
        isOwner(userId) ||
        // Allow followerCount/followingCount increment updates during follow operations
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount']) ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount']) ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline', 'lastSeen']))
      );
      allow delete: if false;

      // Subcollection: /users/{userId}/followers/{followerUid}
      match /followers/{followerUid} {
        allow read: if isAuthenticated();
        // The follower can add themselves, or the target user upon accepting a follow request
        allow create: if isAuthenticated() 
          && (request.auth.uid == followerUid || request.auth.uid == userId)
          && followerUid != userId;
        // Either the follower (unfollowing) or the user (removing follower) can delete
        allow delete: if isAuthenticated() && (request.auth.uid == followerUid || request.auth.uid == userId);
      }

      // Subcollection: /users/{userId}/following/{followingUid}
      match /following/{followingUid} {
        allow read: if isAuthenticated();
        // Only the user themselves or target on follow accept can create following record
        allow create: if isAuthenticated() 
          && (request.auth.uid == userId || request.auth.uid == followingUid)
          && userId != followingUid;
        allow delete: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == followingUid);
      }

      // Subcollection: /users/{userId}/friends/{friendUid}
      match /friends/{friendUid} {
        // STRICT PRIVACY: User can only read, create, and modify their OWN friends subcollection
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: /users/{userId}/saved_messages/{savedMessageId}
      match /saved_messages/{savedMessageId} {
        // STRICT PRIVACY: Only the account owner can read, save, or delete their saved/starred messages
        allow read, write, delete: if isOwner(userId);
      }
    }

    // ----------------------------------------------------
    // Follow Requests (Private Account Approval Workflow)
    // ----------------------------------------------------
    match /follow_requests/{requestId} {
      // Requester or target can read
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.requesterUid ||
        request.auth.uid == resource.data.targetUid
      );

      // Requester can create a pending request
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.requesterUid
        && request.resource.data.requesterUid != request.resource.data.targetUid
        && request.resource.data.status == 'PENDING';

      // Target can accept/decline; requester can cancel
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.targetUid && request.resource.data.status in ['ACCEPTED', 'DECLINED']) ||
        (request.auth.uid == resource.data.requesterUid && request.resource.data.status == 'CANCELLED')
      );

      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.requesterUid ||
        request.auth.uid == resource.data.targetUid
      );
    }

    // ----------------------------------------------------
    // In-App Activity Notifications
    // ----------------------------------------------------
    match /notifications/{notificationId} {
      // Recipient can read their activity notifications
      allow read: if isAuthenticated() && request.auth.uid == resource.data.recipientUid;

      // Actor can dispatch notification to recipient
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.actorUid
        && request.resource.data.actorUid != request.resource.data.recipientUid;

      // Recipient can mark notification as read
      allow update: if isAuthenticated() 
        && request.auth.uid == resource.data.recipientUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.recipientUid;
    }

    // ----------------------------------------------------
    // Safety & Blocking
    // ----------------------------------------------------
    match /blocks/{blockId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.blockerUid ||
        request.auth.uid == resource.data.blockedUid
      );

      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.blockerUid
        && request.resource.data.blockerUid != request.resource.data.blockedUid;

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.blockerUid;
    }

    // ----------------------------------------------------
    // User Reports & Moderation
    // ----------------------------------------------------
    match /reports/{reportId} {
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.reporterUid
        && request.resource.data.reporterUid != request.resource.data.reportedUid
        && request.resource.data.reason is string;
      allow read, update, delete: if false; // Private and immutable
    }

    // ----------------------------------------------------
    // Temporary Pairing Codes (15-min single-use)
    // ----------------------------------------------------
    match /pairing_codes/{codeId} {
      // Authenticated users can query pairing codes
      allow read: if isAuthenticated();

      // Owner can generate an active pairing code
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.ownerUid
        && request.resource.data.used == false
        && request.resource.data.expiresAt > request.time;

      // Code can be cancelled by owner OR claimed once by another user
      allow update: if isAuthenticated() && (
        // Owner can update/cancel
        (request.auth.uid == resource.data.ownerUid) ||
        // Other user claiming code
        (
          resource.data.used == false
          && resource.data.expiresAt > request.time
          && request.auth.uid != resource.data.ownerUid
          && request.resource.data.used == true
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.code == resource.data.code
        )
      );

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.ownerUid;
    }

    // ----------------------------------------------------
    // Pairing Requests (Two-Sided Handshake)
    // ----------------------------------------------------
    match /pairing_requests/{requestId} {
      // Only requester or target can view the request
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.requesterUid || 
        request.auth.uid == resource.data.targetUid
      );

      // Requester can create a pending request
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.requesterUid
        && request.resource.data.requesterUid != request.resource.data.targetUid
        && request.resource.data.status == 'PENDING';

      // Target can accept/reject; requester can cancel
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.targetUid && request.resource.data.status in ['ACCEPTED', 'REJECTED']) ||
        (request.auth.uid == resource.data.requesterUid && request.resource.data.status == 'CANCELLED')
      );

      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.requesterUid || 
        request.auth.uid == resource.data.targetUid
      );
    }

    // ----------------------------------------------------
    // 1-to-1 Chats
    // ----------------------------------------------------
    match /chats/{chatId} {
      // ONLY participants can read their conversations
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;

      // Either participant can create the 1-to-1 channel
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      // Participants can update chat metadata (lastMessage, lastReadAt, lockedBy, hiddenBy), but cannot alter participants
      allow update: if isAuthenticated() 
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      // Subcollection: /chats/{chatId}/messages/{messageId}
      match /messages/{messageId} {
        // ONLY chat participants can read messages
        allow read: if isChatParticipant(chatId);

        // ONLY chat participants can send messages, senderId MUST strictly match auth UID, chatId must match
        allow create: if isChatParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.chatId == chatId
          && request.resource.data.type in ['TEXT', 'IMAGE', 'VOICE']
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 4000
          && (request.resource.data.content.size() > 0 || (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.size() > 0))
          && (request.resource.data.mediaUrl == null || request.resource.data.mediaUrl is string);

        // Message updates:
        // 1. Sender can edit text content, mark isEdited, or unsend (clearing mediaUrl)
        // 2. Recipient can update reaction, delivery/seen status, or delete for me
        // 3. Changing senderId, chatId, or timestamp is strictly denied
        allow update: if isChatParticipant(chatId)
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.chatId == resource.data.chatId
          && (
            // Sender editing or unsending
            (
              request.auth.uid == resource.data.senderId
              && (
                // Unsending
                (request.resource.data.isUnsent == true && request.resource.data.mediaUrl == null) ||
                // Editing content
                (request.resource.data.mediaUrl == resource.data.mediaUrl && request.resource.data.content is string && request.resource.data.content.size() <= 4000)
              )
            ) ||
            // Recipient updating reaction, delivery/seen status, or delete for me
            (
              request.resource.data.content == resource.data.content
              && request.resource.data.isUnsent == resource.data.isUnsent
              && request.resource.data.mediaUrl == resource.data.mediaUrl
            )
          );

        allow delete: if false;
      }

      // Subcollection: /chats/{chatId}/presence/{userId} ("In this chat" presence)
      match /presence/{userId} {
        allow read: if isChatParticipant(chatId);
        allow write: if isChatParticipant(chatId) && request.auth.uid == userId;
      }
    }

    // ----------------------------------------------------
    // 24-Hour Disappearing Stories & Archive
    // ----------------------------------------------------
    match /stories/{storyId} {
      // 1. Single Document Read (get): Strictly enforced server-side privacy check
      // Author can read, or audience check (everyone vs close friends list)
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (
          resource.data.expiresAt > request.time &&
          (
            resource.data.audience != 'CLOSE_FRIENDS' ||
            (resource.data.closeFriends is list && request.auth.uid in resource.data.closeFriends)
          )
        )
      );

      // 2. Feed Query (list): Authenticated users can list active stories
      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.expiresAt > request.time
      );

      // 3. Only author can create their story
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.mediaUrl is string;

      // 4. Author can edit; viewers can only append to viewedBy or reactions
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy', 'reactions'])
      );

      // 5. Only author can delete their story
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // ----------------------------------------------------
    // 1-to-1 Audio & Video Calling (WebRTC Signaling)
    // ----------------------------------------------------
    match /calls/{callId} {
      // Authenticated users can read signaling document for call coordination
      allow read: if isAuthenticated();

      // Authenticated caller can start call
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.callerUid;

      // Caller and receiver can update call status / SDP answer / duration
      allow update: if isAuthenticated();

      allow delete: if isAuthenticated();

      // ICE Candidates subcollection
      match /candidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ----------------------------------------------------
    // Call History (Private to Caller and Receiver)
    // ----------------------------------------------------
    match /call_history/{historyId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.callerUid ||
        request.auth.uid == resource.data.receiverUid
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.callerUid ||
        request.auth.uid == request.resource.data.receiverUid
      );
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.callerUid ||
        request.auth.uid == resource.data.receiverUid
      );
    }

    // ----------------------------------------------------
    // Notifications & Activity System
    // ----------------------------------------------------
    match /notifications/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated();
    }
  }
}
